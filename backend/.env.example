# ===================================================
# MailMind Backend – Environment Variables
# ===================================================
# Copy this file to .env and fill in your values.

# Server port
PORT=5000

# -------------------------------------------------
# MongoDB Connection (REQUIRED)
# -------------------------------------------------
# Option A: MongoDB Atlas (Free tier – recommended)
#   1. Go to https://mongodb.com/atlas and sign up free
#   2. Create a free M0 cluster
#   3. Click Connect → Drivers → copy the connection string
#   4. Replace <username>, <password>, <cluster> below:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/email-dashboard?retryWrites=true&w=majority
#
# Option B: Local MongoDB
#   Install from https://mongodb.com/try/download/community then run: mongod
# MONGODB_URI=mongodb://localhost:27017/email-dashboard

MONGODB_URI=mongodb://localhost:27017/email-dashboard

# -------------------------------------------------
# JWT Authentication
# -------------------------------------------------
JWT_SECRET=supersecretjwtkey_changeme_in_production
JWT_EXPIRES_IN=7d

# -------------------------------------------------
# AI Integration (Optional)
# -------------------------------------------------
# Leave blank or as-is to use the built-in keyword-based mock AI.
# To use real OpenAI GPT-4o-mini classification, add your API key:
# OPENAI_API_KEY=sk-...your-key-here...
OPENAI_API_KEY=optional_put_your_openai_key_here

# Node environment
NODE_ENV=development
